+#[derive(Clone)]
+struct RelationSource {
+    file_id: FileId,
+    range: TextRange,
+    kind: SymbolInformationKind,
+    symbol: String,
+    body: Option<(FileId, TextRange)>,
+}
+
+const MAX_RELATION_SIDECAR_BYTES: usize = 64 * 1024 * 1024;
+const MAX_TYPED_RELATIONS: usize = 250_000;
+const MAX_RELATION_FIELD_BYTES: usize = 4096;
+
+#[derive(Default)]
+struct LimitedRelationBuffer(Vec<u8>);
+
+impl LimitedRelationBuffer {
+    fn into_inner(self) -> Vec<u8> {
+        self.0
+    }
+}
+
+impl Write for LimitedRelationBuffer {
+    fn write(&mut self, data: &[u8]) -> std::io::Result<usize> {
+        if self.0.len().saturating_add(data.len()) > MAX_RELATION_SIDECAR_BYTES {
+            return Err(std::io::Error::other("semantic relation sidecar exceeds its byte limit"));
+        }
+        self.0.extend_from_slice(data);
+        Ok(data.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+#[derive(serde::Serialize)]
+struct RelationSidecar {
+    schema_version: u32,
+    relations: Vec<TypedRelation>,
+}
+
+#[derive(serde::Serialize)]
+struct TypedRelation {
+    kind: &'static str,
+    source_document: String,
+    source_symbol: String,
+    target_symbol: String,
+    range: TypedRange,
+}
+
+#[derive(serde::Serialize)]
+struct TypedRange {
+    start: TypedPosition,
+    end: TypedPosition,
+}
+
+#[derive(serde::Serialize)]
+struct TypedPosition {
+    line: u32,
+    character: u32,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+enum RelationKind {
+    Implementation,
+    TypeDefinition,
+}
+
+fn collect_semantic_relationships(
+    analysis: &Analysis,
+    sources: &[RelationSource],
+    symbols_at_occurrence: &FxHashMap<(FileId, TextRange), String>,
+    symbols_at_definition: &FxHashMap<(FileId, TextRange), String>,
+) -> anyhow::Result<FxHashMap<String, Vec<scip_types::Relationship>>> {
+    let mut seen: FxHashSet<(String, String, RelationKind)> = FxHashSet::default();
+    let mut result: FxHashMap<String, Vec<scip_types::Relationship>> = FxHashMap::default();
+    let implementation_config =
+        GotoImplementationConfig { filter_adjacent_derive_implementations: true };
+
+    for source in sources {
+        let position = FilePosition { file_id: source.file_id, offset: source.range.start() };
+        let (kind, targets): (RelationKind, Vec<NavigationTarget>) = match source.kind {
+            SymbolInformationKind::Trait => {
+                let found =
+                    analysis.goto_implementation(&implementation_config, position).map_err(
+                        |_| anyhow::anyhow!("SCIP trait implementation query was cancelled"),
+                    )?;
+                let Some(found) = found else { continue };
+                (RelationKind::Implementation, found.info)
+            }
+            SymbolInformationKind::Parameter
+            | SymbolInformationKind::Field
+            | SymbolInformationKind::Variable => {
+                let found = analysis
+                    .goto_type_definition(position)
+                    .map_err(|_| anyhow::anyhow!("SCIP declaration type query was cancelled"))?;
+                let Some(found) = found else { continue };
+                (RelationKind::TypeDefinition, found.info)
+            }
+            _ => continue,
+        };
+
+        for target in targets {
+            let target_range = target.focus_or_full_range();
+            let target_symbol = symbols_at_definition
+                .get(&(target.file_id, target_range))
+                .or_else(|| symbols_at_occurrence.get(&(target.file_id, target_range)));
+            let Some(target_symbol) = target_symbol else {
+                continue;
+            };
+            // SCIP relationships are outgoing from the implementation/type owner. A trait query
+            // returns its implementors, so that edge must be reversed before it is attached.
+            let (relationship_source, relationship_target) = match kind {
+                RelationKind::Implementation => (target_symbol.clone(), source.symbol.clone()),
+                RelationKind::TypeDefinition => (source.symbol.clone(), target_symbol.clone()),
+            };
+            if relationship_source == relationship_target
+                || !seen.insert((relationship_source.clone(), relationship_target.clone(), kind))
+            {
+                continue;
+            }
+            let relationship = match kind {
+                RelationKind::Implementation => scip_types::Relationship {
+                    symbol: relationship_target,
+                    is_implementation: true,
+                    ..Default::default()
+                },
+                RelationKind::TypeDefinition => scip_types::Relationship {
+                    symbol: relationship_target,
+                    is_type_definition: true,
+                    ..Default::default()
+                },
+            };
+            result.entry(relationship_source).or_default().push(relationship);
+        }
+    }
+
+    Ok(result)
+}
+
+fn collect_typed_relations(
+    analysis: &Analysis,
+    db: &RootDatabase,
+    vfs: &vfs::Vfs,
+    root: &vfs::AbsPathBuf,
+    sources: &[RelationSource],
+    symbols_at_occurrence: &FxHashMap<(FileId, TextRange), String>,
+    symbols_at_definition: &FxHashMap<(FileId, TextRange), String>,
+) -> anyhow::Result<Vec<TypedRelation>> {
+    let mut relations = Vec::new();
+    let mut seen: FxHashSet<TypedRelationKey> = FxHashSet::default();
+    let mut relation_bytes = 0usize;
+    let call_config =
+        CallHierarchyConfig { exclude_tests: false, ra_fixture: RaFixtureConfig::default() };
+
+    for source in sources {
+        if !is_callable_kind(source.kind) {
+            continue;
+        }
+        let calls = analysis
+            .outgoing_calls(
+                &call_config,
+                FilePosition { file_id: source.file_id, offset: source.range.start() },
+            )
+            .map_err(|_| anyhow::anyhow!("SCIP outgoing-call query was cancelled"))?;
+        let Some(calls) = calls else { continue };
+        for call in calls {
+            let target_range = call.target.focus_or_full_range();
+            let Some(target_symbol) =
+                symbols_at_definition.get(&(call.target.file_id, target_range))
+            else {
+                anyhow::bail!(
+                    "resolved Rust call target has no SCIP symbol at {:?}:{:?}",
+                    call.target.file_id,
+                    target_range
+                );
+            };
+            for call_range in call.ranges {
+                if !source_owns_call_range(source, call_range.file_id, call_range.range, sources) {
+                    continue;
+                }
+                let relative_path = get_relative_filepath(vfs, root, call_range.file_id)
+                    .ok_or_else(|| {
+                        anyhow::anyhow!("Rust call range is outside the SCIP workspace")
+                    })?;
+                let line_index = get_line_index(db, call_range.file_id);
+                let range = typed_range(&line_index, call_range.range);
+                push_typed_relation(
+                    &mut relations,
+                    &mut seen,
+                    &mut relation_bytes,
+                    TypedRelation {
+                        kind: "call",
+                        source_document: relative_path,
+                        source_symbol: source.symbol.clone(),
+                        target_symbol: target_symbol.clone(),
+                        range,
+                    },
+                )?;
+            }
+        }
+    }
+
+    for source in sources {
+        if source.kind != SymbolInformationKind::Module {
+            continue;
+        }
+        let Some((file_id, body_range)) = source.body else { continue };
+        let children = analysis
+            .child_modules(FilePosition { file_id, offset: body_range.start() })
+            .map_err(|_| anyhow::anyhow!("SCIP child-module query was cancelled"))?;
+        for child in children {
+            let child_range = child.focus_or_full_range();
+            let Some(child_symbol) = symbols_at_definition
+                .get(&(child.file_id, child_range))
+                .or_else(|| symbols_at_occurrence.get(&(child.file_id, child_range)))
+            else {
+                anyhow::bail!(
+                    "Rust child module has no SCIP symbol at {:?}:{:?}",
+                    child.file_id,
+                    child_range
+                );
+            };
+            if child_symbol == &source.symbol {
+                continue;
+            }
+            let relative_path =
+                get_relative_filepath(vfs, root, child.file_id).ok_or_else(|| {
+                    anyhow::anyhow!("Rust module declaration is outside the SCIP workspace")
+                })?;
+            let line_index = get_line_index(db, child.file_id);
+            push_typed_relation(
+                &mut relations,
+                &mut seen,
+                &mut relation_bytes,
+                TypedRelation {
+                    kind: "module",
+                    source_document: relative_path,
+                    source_symbol: source.symbol.clone(),
+                    target_symbol: child_symbol.clone(),
+                    range: typed_range(&line_index, child_range),
+                },
+            )?;
+        }
+    }
+
+    if relations.len() > MAX_TYPED_RELATIONS {
+        anyhow::bail!("semantic relation sidecar exceeds its relation-count limit");
+    }
+    relations.sort_by(|left, right| {
+        (
+            left.kind,
+            left.source_document.as_str(),
+            left.source_symbol.as_str(),
+            left.target_symbol.as_str(),
+            left.range.start.line,
+            left.range.start.character,
+            left.range.end.line,
+            left.range.end.character,
+        )
+            .cmp(&(
+                right.kind,
+                right.source_document.as_str(),
+                right.source_symbol.as_str(),
+                right.target_symbol.as_str(),
+                right.range.start.line,
+                right.range.start.character,
+                right.range.end.line,
+                right.range.end.character,
+            ))
+    });
+    Ok(relations)
+}
+
+type TypedRelationKey = (&'static str, String, String, String, u32, u32, u32, u32);
+
+fn push_typed_relation(
+    relations: &mut Vec<TypedRelation>,
+    seen: &mut FxHashSet<TypedRelationKey>,
+    relation_bytes: &mut usize,
+    relation: TypedRelation,
+) -> anyhow::Result<()> {
+    if relation.source_document.len() > MAX_RELATION_FIELD_BYTES
+        || relation.source_symbol.len() > MAX_RELATION_FIELD_BYTES
+        || relation.target_symbol.len() > MAX_RELATION_FIELD_BYTES
+    {
+        anyhow::bail!("semantic relation record exceeds its field-size limit");
+    }
+    let key = (
+        relation.kind,
+        relation.source_document.clone(),
+        relation.source_symbol.clone(),
+        relation.target_symbol.clone(),
+        relation.range.start.line,
+        relation.range.start.character,
+        relation.range.end.line,
+        relation.range.end.character,
+    );
+    if seen.insert(key) {
+        if relations.len() >= MAX_TYPED_RELATIONS {
+            anyhow::bail!("semantic relation sidecar exceeds its relation-count limit");
+        }
+        let field_bytes = relation
+            .source_document
+            .len()
+            .saturating_add(relation.source_symbol.len())
+            .saturating_add(relation.target_symbol.len())
+            .saturating_add(relation.kind.len());
+        let record_budget = field_bytes.saturating_mul(6).saturating_add(256);
+        if (*relation_bytes).saturating_add(record_budget) > MAX_RELATION_SIDECAR_BYTES {
+            anyhow::bail!("semantic relation sidecar exceeds its aggregate record-size limit");
+        }
+        *relation_bytes += record_budget;
+        relations.push(relation);
+    }
+    Ok(())
+}
+
+fn is_callable_kind(kind: SymbolInformationKind) -> bool {
+    matches!(
+        kind,
+        SymbolInformationKind::Function
+            | SymbolInformationKind::Method
+            | SymbolInformationKind::StaticMethod
+            | SymbolInformationKind::TraitMethod
+            | SymbolInformationKind::Constant
+            | SymbolInformationKind::StaticVariable
+    )
+}
+
+fn source_owns_call_range(
+    source: &RelationSource,
+    file_id: FileId,
+    range: TextRange,
+    sources: &[RelationSource],
+) -> bool {
+    let Some((body_file, body)) = source.body else { return false };
+    if body_file != file_id || range.start() < body.start() || range.end() > body.end() {
+        return false;
+    }
+    !sources.iter().any(|nested| {
+        if !is_callable_kind(nested.kind)
+            || (nested.file_id == source.file_id
+                && nested.range == source.range
+                && nested.symbol == source.symbol)
+        {
+            return false;
+        }
+        let Some((nested_file, nested_body)) = nested.body else { return false };
+        nested_file == file_id
+            && nested_body.len() < body.len()
+            && nested_body.start() <= range.start()
+            && range.end() <= nested_body.end()
+    })
+}
+
+fn typed_range(line_index: &LineIndex, range: TextRange) -> TypedRange {
+    let start = line_index.index.line_col(range.start());
+    let end = line_index.index.line_col(range.end());
+    let start = line_index
+        .index
+        .to_wide(ide_db::line_index::WideEncoding::Utf16, start)
+        .expect("a source range start has a valid UTF-16 position");
+    let end = line_index
+        .index
+        .to_wide(ide_db::line_index::WideEncoding::Utf16, end)
+        .expect("a source range end has a valid UTF-16 position");
+    TypedRange {
+        start: TypedPosition { line: start.line, character: start.col },
+        end: TypedPosition { line: end.line, character: end.col },
+    }
+}
