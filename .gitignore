# Go build, test, coverage, and release outputs.
*.exe
*.test
coverage.out
/.tmp-gocache/
dist/
dist-smoke/
sbom.cdx.json
/test/acceptance/tools/node_modules/
/editors/vscode/node_modules/
/test/acceptance/tools/.npm-cache/
/test/acceptance/tools/bin/
/test/acceptance/evidence/

# Local editor / test scratch; do not commit.
/.tmp-client-native-evidence/
/.tmp-helix-native-evidence/
/.tmp-ra-patchbase/
nvim.log

# Per-user tool configuration; keep local ZCode settings out of the repository.
/.zcodeignore

# Operating-system metadata generated by local file browsers.
.DS_Store
Thumbs.db
desktop.ini
__pycache__/

# Local test binaries and zcode workflow state.
/.tmp-omnilsp-scheduler-trace.exe
/.tmp-golang-test.exe
/.zcode/

# Local test evidence with absolute paths; never commit.
/test/corpus/test/

# Generated per-run evidence artifacts, not source control inputs:
#   - out/ holds local iteration/audit reports written by agent runs;
#   - sbom.cdx.json is regenerated per gate run (gen-sbom.go embeds a
#     wall-clock timestamp and a date-keyed serial, so every regeneration
#     churns); release evidence lives under test/acceptance/evidence/<runId>/.
/out/
